+/* DBY_FORCE_PERMISSIVE: flip to permissive once boot has settled */
+static int dby_perm_delay __read_mostly = 60;
+module_param_named(dby_perm_delay, dby_perm_delay, int, 0644);
+
+static void dby_perm_work(struct work_struct *work)
+{
+	enforcing_set(&selinux_state, false);
+	selinux_status_update_setenforce(&selinux_state, 0);
+	pr_info("SELinux: DBY_FORCE_PERMISSIVE flip -> permissive\n");
+}
+static DECLARE_DELAYED_WORK(dby_perm_dw, dby_perm_work);
+
 static __init int selinux_init(void)
 {
 	if (!security_module_enable("selinux")) {
@@ -7293,6 +7307,9 @@
 
